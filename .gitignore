# ===== 视频/媒体文件（防止大文件误提交）=====
*.mp4
*.mov
*.avi
*.wmv
*.flv
*.rm*
*.mkv
# 入口测试素材 input_*.mkv 由 test/make_fixtures.sh 生成: 脚本入库, 产物不入库
*.ts
*.m2ts
*.webm
dvd_sample.iso

# ===== .bat 脚本产生的临时文件 =====
temp
temp.txt
size
duration
bit_rate

# ===== Office 临时文件 =====
~$*
*.tmp

# ===== 系统文件 =====
Thumbs.db
desktop.ini

# ===== 测试套件（test/）的运行产物（套件脚本本身要提交）=====
test/bat/smoke_logs/
test/bat/chars_logs/
test/sh/logs/

# ===== Python 字节码缓存（任意子目录下，lint 跑过就会生成）=====
__pycache__/
*.py[cod]
